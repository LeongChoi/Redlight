<Window x:Class="RedLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Red Light Compact"
        Height="132" Width="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Border CornerRadius="8"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.4" ShadowDepth="2" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="EnableFilterCheckBox"
                          Content="On"
                          Style="{DynamicResource ThemedCheckBox}"
                          VerticalAlignment="Center"
                          Checked="ApplyFilter"
                          Unchecked="ApplyFilter"/>
                <CheckBox x:Name="StartupCheckBox" Grid.Column="1"
                          Content="Start with Windows"
                          Style="{DynamicResource ThemedCheckBox}"
                          VerticalAlignment="Center"
                          Checked="StartupCheckBox_Changed"
                          Unchecked="StartupCheckBox_Changed"/>
                <Button Grid.Column="2" Click="QuitButton_Click"
                        Style="{DynamicResource MenuButtonStyle}"
                        HorizontalContentAlignment="Center" Padding="4,4">
                    <TextBlock Text="Quit" Foreground="#FFE74856"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Warmth"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
                <Slider x:Name="WarmthSlider" Grid.Column="1"
                        Minimum="0" Maximum="100" Value="50"
                        SmallChange="1" LargeChange="5"
                        IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"
                        Style="{DynamicResource ThemedSlider}"
                        AutoToolTipPlacement="None"
                        ToolTipService.IsEnabled="False"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock x:Name="WarmthValueText" Grid.Column="2"
                           Text="≈6500K" TextAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="DimRow" Grid.Row="4" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Dim"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
                <Slider x:Name="DimSlider" Grid.Column="1"
                        Minimum="0" Maximum="70" Value="0"
                        SmallChange="1" LargeChange="5"
                        IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"
                        Style="{DynamicResource ThemedSlider}"
                        AutoToolTipPlacement="None"
                        ToolTipService.IsEnabled="False"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock x:Name="DimValueText" Grid.Column="2"
                           Text="0%" TextAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
